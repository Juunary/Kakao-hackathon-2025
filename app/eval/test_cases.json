      "turn_2": { "haptics_pattern": "ITEM_TICK", "tts_contains_any": ["번째 거래"] }
    }
  },
  {
    "id": "transfer_01",
    "category": "transfer",
    "description": "Transfer intent then CONFIRM — full happy path",
    "user_id": "u_001",
